@echo off
setlocal
title Resume BC Silinda DEMO robot
powershell.exe -NoProfile -Command "$ErrorActionPreference='Stop'; try { Add-Type -AssemblyName System.Windows.Forms; $url='http://127.0.0.1:8765'; $session=Invoke-RestMethod -Uri ($url+'/api/auth/session') -SessionVariable bcSession; $state=Invoke-RestMethod -Uri ($url+'/api/status') -WebSession $bcSession; if(-not $state.connected){throw 'MT5 is disconnected. Reconnect XM in MT5, then run this shortcut again.'}; if($state.mode -ne 'demo'){throw 'This shortcut only resumes DEMO accounts.'}; if($state.robot_state -eq 'running'){Write-Host 'The demo robot is already running.'; exit 0}; $answer=[System.Windows.Forms.MessageBox]::Show('Resume automatic DEMO trading? Existing risk checks remain active.','Resume demo robot','YesNo','Question'); if($answer -ne 'Yes'){exit 0}; $body=@{action='resume';confirmation='RESUME DEMO';request_id=[Guid]::NewGuid().ToString('N')} | ConvertTo-Json; $result=Invoke-RestMethod -Uri ($url+'/api/control') -Method Post -WebSession $bcSession -Headers @{'X-CSRF-Token'=$session.csrf_token} -ContentType 'application/json' -Body $body; Write-Host 'Resume requested. Waiting for MT5 acknowledgment...'; for($i=0;$i -lt 20;$i++){Start-Sleep -Milliseconds 500; $state=Invoke-RestMethod -Uri ($url+'/api/status') -WebSession $bcSession; if($state.robot_state -eq 'running'){Write-Host 'MT5 reports RUNNING. Refresh your dashboard.'; break}; if($state.last_ack.command_id -eq $result.command_id){Write-Host $state.last_ack.message; break}}; Write-Host ('Robot state: '+$state.robot_state); Write-Host $state.reason; Write-Host 'Refresh your dashboard. A requested resume is not a confirmed trade.' } catch { Write-Host ('Resume stopped: '+$_.Exception.Message) -ForegroundColor Red; Write-Host 'Keep the local Windows dashboard service running. Do not enter broker passwords in this shortcut.'; exit 1 }"
echo.
pause
endlocal
