# Copy to a private environment file. Do not commit real banking credentials.
LOOP_PUBLIC_URL=https://your-management-domain.example
LOOP_DATA_DIR=/var/lib/loop-manager
# For local admin UI development only: LOOP_DEV=1
# Customer Android app always requires a trusted HTTPS connection.
LOOP_EFT_BANK=
LOOP_EFT_HOLDER=
LOOP_EFT_ACCOUNT=
LOOP_EFT_BRANCH=
