<resources>
    <style name="PreviewTheme" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">#000000</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#000000</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorSurfaceVariant">#F4F4F4</item>
        <item name="colorOnSurface">#000000</item>
        <item name="colorOnSurfaceVariant">#595959</item>
        <item name="colorOutline">#DDDDDD</item>
        <item name="android:colorAccent">#000000</item>
        <item name="android:textColorPrimary">#000000</item>
        <item name="android:textColorSecondary">#595959</item>
        <item name="fontFamily">@font/lato_regular</item>
        <item name="android:fontFamily">@font/lato_regular</item>
        <item name="materialAlertDialogTheme">@style/LoopInstrumentDialog</item>
        <item name="shapeAppearanceCornerSmall">@style/LoopControlShape</item>
        <item name="shapeAppearanceCornerMedium">@style/LoopControlShape</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#FFFFFF</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">#FFFFFF</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <style name="LoopControlShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">4dp</item>
    </style>
    <style name="LoopInstrumentDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#000000</item>
        <item name="colorPrimary">#000000</item>
        <item name="shapeAppearance">@style/LoopControlShape</item>
        <item name="materialAlertDialogTitleTextStyle">@style/LoopDialogTitle</item>
        <item name="materialAlertDialogBodyTextStyle">@style/LoopDialogBody</item>
        <item name="buttonBarPositiveButtonStyle">@style/LoopDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/LoopDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/LoopDialogButton</item>
    </style>
    <style name="LoopDialogTitle" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="fontFamily">@font/barlow_condensed</item>
        <item name="android:fontFamily">@font/barlow_condensed</item>
        <item name="android:textColor">#000000</item>
        <item name="android:textSize">24sp</item>
    </style>
    <style name="LoopDialogBody" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="fontFamily">@font/lato_regular</item>
        <item name="android:fontFamily">@font/lato_regular</item>
        <item name="android:textColor">#595959</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="LoopDialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="fontFamily">@font/lato_regular</item>
        <item name="android:fontFamily">@font/lato_regular</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">#000000</item>
    </style>
</resources>
