<resources>
    <style name="PreviewTheme" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">#315E48</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#315E48</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorSurfaceVariant">#E5EDDF</item>
        <item name="colorOnSurface">#1C2C24</item>
        <item name="colorOnSurfaceVariant">#6C766D</item>
        <item name="colorOutline">#DCE1D6</item>
        <item name="android:colorAccent">#315E48</item>
        <item name="android:textColorPrimary">#1C2C24</item>
        <item name="android:textColorSecondary">#6C766D</item>
        <item name="fontFamily">@font/dm_sans_regular</item>
        <item name="android:fontFamily">@font/dm_sans_regular</item>
        <item name="materialAlertDialogTheme">@style/LoopInstrumentDialog</item>
        <item name="shapeAppearanceCornerSmall">@style/LoopControlShape</item>
        <item name="shapeAppearanceCornerMedium">@style/LoopControlShape</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F4F4EE</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">#F4F4EE</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <style name="LoopControlShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">15dp</item>
    </style>
    <style name="LoopInstrumentDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#1C2C24</item>
        <item name="colorPrimary">#315E48</item>
        <item name="shapeAppearance">@style/LoopControlShape</item>
        <item name="materialAlertDialogTitleTextStyle">@style/LoopDialogTitle</item>
        <item name="materialAlertDialogBodyTextStyle">@style/LoopDialogBody</item>
        <item name="buttonBarPositiveButtonStyle">@style/LoopDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/LoopDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/LoopDialogButton</item>
    </style>
    <style name="LoopDialogTitle" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="fontFamily">@font/fraunces_regular</item>
        <item name="android:fontFamily">@font/fraunces_regular</item>
        <item name="android:textColor">#1C2C24</item>
        <item name="android:textSize">24sp</item>
    </style>
    <style name="LoopDialogBody" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="fontFamily">@font/dm_sans_regular</item>
        <item name="android:fontFamily">@font/dm_sans_regular</item>
        <item name="android:textColor">#6C766D</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="LoopDialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="fontFamily">@font/dm_sans_medium</item>
        <item name="android:fontFamily">@font/dm_sans_medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">#315E48</item>
    </style>
</resources>
